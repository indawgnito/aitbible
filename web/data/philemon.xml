          <w lemma="καί">καὶ</w>
          <w lemma="σεαυτοῦ">σεαυτόν</w>
          <w lemma="ἐγώ">μοι</w>
          <w lemma="προσοφείλω">προσοφείλεις.</w>
        </greek>
      </verse>
