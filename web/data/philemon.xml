        <greek>
          <w lemma="ἐγώ">ἐγὼ</w>
          <w lemma="Παῦλος">Παῦλος</w>
          <w lemma="γράφω">ἔγραψα</w>
          <w lemma="ὁ">τῇ</w>
          <w lemma="ἐμός">ἐμῇ</w>
          <w lemma="χείρ">χειρί,</w>
          <w lemma="ἐγώ">ἐγὼ</w>
          <w lemma="ἀποτίνω">ἀποτίσω·</w>
          <w lemma="ἵνα">ἵνα</w>
          <w lemma="μή">μὴ</w>
          <w lemma="λέγω">λέγω</w>
