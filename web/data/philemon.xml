          <w lemma="γράφω">ἔγραψά</w>
          <w lemma="σύ">σοι,</w>
          <w lemma="ὁράω">εἰδὼς</w>
          <w lemma="ὅτι">ὅτι</w>
          <w lemma="καί">καὶ</w>
          <w lemma="ὑπέρ">ὑπὲρ</w>
          <w lemma="ὅς">ἃ</w>
