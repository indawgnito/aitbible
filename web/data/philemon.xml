    <chapter num="1">
      <verse num="1">
        <text><p/>Paul, a prisoner of Christ Jesus, and Timothy our brother, to Philemon, our beloved friend and coworker,</text>
        <greek>
          <w lemma="Παῦλος">Παῦλος</w>
          <w lemma="δέσμιος">δέσμιος</w>
          <w lemma="Χριστός">Χριστοῦ</w>
