          <w lemma="κύριος">κυρίου</w>
          <w lemma="Ἰησοῦς">Ἰησοῦ</w>
          <w lemma="Χριστός">Χριστοῦ.</w>
        </greek>
      </verse>
      <verse num="4">
        <text><p/>I thank my God always when I mention you in my prayers,</text>
        <greek>
          <w lemma="εὐχαριστέω">Εὐχαριστῶ</w>
          <w lemma="ὁ">τῷ</w>
          <w lemma="θεός">θεῷ</w>
          <w lemma="ἐγώ">μου</w>
