          <w lemma="ἐγώ">ἐμοί,</w>
          <w lemma="πόσος">πόσῳ</w>
          <w lemma="δέ">δὲ</w>
          <w lemma="μᾶλλον">μᾶλλον</w>
          <w lemma="σύ">σοὶ</w>
          <w lemma="καί">καὶ</w>
          <w lemma="ἐν">ἐν</w>
          <w lemma="σάρξ">σαρκὶ</w>
          <w lemma="καί">καὶ</w>
          <w lemma="ἐν">ἐν</w>
          <w lemma="κύριος">κυρίῳ.</w>
        </greek>
      </verse>
      <verse num="17">
        <text><p/>So if you consider me a partner, welcome him as you would me.</text>
        <greek>
          <w lemma="εἰ">Εἰ</w>
          <w lemma="οὖν">οὖν</w>
          <w lemma="ἐγώ">με</w>
          <w lemma="ἔχω">ἔχεις</w>
          <w lemma="κοινωνός">κοινωνόν,</w>
          <w lemma="προσλαμβάνομαι">προσλαβοῦ</w>
          <w lemma="αὐτός">αὐτὸν</w>
          <w lemma="ὡς">ὡς</w>
          <w lemma="ἐγώ">ἐμέ.</w>
        </greek>
      </verse>
      <verse num="18">
        <text>And if he has wronged you in any way or owes you anything, charge it to me.</text>
        <greek>
          <w lemma="εἰ">εἰ</w>
          <w lemma="δέ">δέ</w>
          <w lemma="τις">τι</w>
          <w lemma="ἀδικέω">ἠδίκησέν</w>
          <w lemma="σύ">σε</w>
          <w lemma="ἤ">ἢ</w>
          <w lemma="ὀφείλω">ὀφείλει,</w>
