        <greek>
          <w lemma="ναί">ναί,</w>
          <w lemma="ἀδελφός">ἀδελφέ,</w>
          <w lemma="ἐγώ">ἐγώ</w>
          <w lemma="σύ">σου</w>
          <w lemma="ὀνίνημι">ὀναίμην</w>
          <w lemma="ἐν">ἐν</w>
          <w lemma="κύριος">κυρίῳ·</w>
          <w lemma="ἀναπαύω">ἀνάπαυσόν</w>
          <w lemma="ἐγώ">μου</w>
          <w lemma="ὁ">τὰ</w>
          <w lemma="σπλάγχνον">σπλάγχνα</w>
          <w lemma="ἐν">ἐν</w>
